; Ported from public/signup.html — keep the shared shell in site/site.soil.

(defun main ()
  (println
    (page
      "Start free — Mycelium"
      "Start with the open-source project, or join the hosted early access for a managed Mycelium desktop."
      "https://mycelium.fpl.dev/signup"
      (list
      (el "section" (list (attr :class "page-hero")) (list
        (el "div" (list (attr :class "wrap")) (list
          (el "p" (list (attr :class "eyebrow")) (list
            (txt "Start free")
          ))
          (el "h1" nil (list
            (txt "Open your hosted desktop.")
          ))
          (el "p" (list (attr :class "lede")) (list
            (txt "Start a 7-day hosted trial at m.fpl.dev. Add a card, open your desktop, and keep the self-hosted path free forever.")
          ))
        ))
      ))
      (el "section" (list (attr :class "section") (attr :style "padding-top:20px")) (list
        (el "div" (list (attr :class "wrap page-grid")) (list
          (el "article" (list (attr :class "panel dark")) (list
            (el "p" (list (attr :class "eyebrow light")) (list
              (txt "Self-hosted")
            ))
            (el "h2" nil (list
              (txt "Free, forever.")
            ))
            (el "p" nil (list
              (txt "Run Mycelium on your laptop or server. Bring your own model keys, your own storage, and your own domain. No license key, no seat count, no phone-home requirement.")
            ))
            (el "div" (list (attr :class "hero-actions") (attr :style "margin-top:18px")) (list
              (el "a" (list (attr :class "btn primary") (attr :href "/download")) (list
                (txt "Install Mycelium")
              ))
              (el "a" (list (attr :class "btn ghost") (attr :href "https://github.com/mycelium-linux/mycelium")) (list
                (txt "View source")
              ))
            ))
          ))
          (el "article" (list (attr :class "panel")) (list
            (el "p" (list (attr :class "eyebrow")) (list
              (txt "Hosted desktop")
            ))
            (el "h2" nil (list
              (txt "We run the desktop.")
            ))
            (el "p" nil (list
              (txt "Start with two desktops at m.fpl.dev: Personal and Work. Your card starts the trial; cancel from the billing portal at any time.")
            ))
            (el "form" (list (attr :id "hosted-signup") (attr :style "margin-top:18px") (attr :novalidate #t)) (list
              (el "div" (list (attr :class "field")) (list
                (el "label" (list (attr :for "signup-email")) (list
                  (txt "Work email")
                ))
                (el "input" (list (attr :id "signup-email") (attr :name "email") (attr :type "email") (attr :autocomplete "email") (attr :placeholder "you@company.com") (attr :required #t)) nil)
              ))
              (el "div" (list (attr :class "field")) (list
                (el "label" (list (attr :for "signup-plan")) (list
                  (txt "Plan")
                ))
                (el "select" (list (attr :id "signup-plan") (attr :name "plan") (attr :style "width:100%;padding:12px;border:1px solid var(--line);background:var(--bg);color:var(--text)")) (list
                  (el "option" (list (attr :value "starter")) (list (txt "Solo · $15/mo")))
                  (el "option" (list (attr :value "team")) (list (txt "Team · $30/seat/mo")))
                  (el "option" (list (attr :value "business")) (list (txt "Business · $99/mo")))
                ))
              ))
              (el "div" (list (attr :class "field")) (list
                (el "label" (list (attr :for "signup-interval")) (list
                  (txt "Billing")
                ))
                (el "select" (list (attr :id "signup-interval") (attr :name "interval") (attr :style "width:100%;padding:12px;border:1px solid var(--line);background:var(--bg);color:var(--text)")) (list
                  (el "option" (list (attr :value "monthly")) (list (txt "Monthly")))
                  (el "option" (list (attr :value "annual")) (list (txt "Annual · 2 months free")))
                ))
              ))
              (el "div" (list (attr :class "auth-actions")) (list
                (el "button" (list (attr :class "btn primary") (attr :type "submit")) (list
                  (txt "Start 7-day trial ")
                  (el "span" (list (attr :class "arrow") (attr :aria-hidden "true")) (list
                    (txt "→")
                  ))
                ))
              ))
              (el "p" (list (attr :id "signup-status") (attr :class "auth-small") (attr :role "status") (attr :aria-live "polite")) nil)
            ))
            (el "p" (list (attr :class "auth-small")) (list
              (txt "Prefer to talk first? ")
              (el "a" (list (attr :href "mailto:hello@fpl.dev?subject=Mycelium")) (list
                (txt "hello@fpl.dev")
              ))
              (txt ".")
            ))
          ))
        ))
      ))
      (el "section" (list (attr :class "section")) (list
        (el "div" (list (attr :class "wrap")) (list
          (el "div" (list (attr :class "three reveal")) (list
            (el "article" (list (attr :class "feature")) (list
              (el "span" (list (attr :class "num")) (list
                (txt "01")
              ))
              (el "h3" nil (list
                (txt "Passkeys through FPL Auth")
              ))
              (el "p" nil (list
                (txt "Sign in with FPL Auth. Your hosted desktop stays behind the same identity as the rest of FPL.")
              ))
            ))
            (el "article" (list (attr :class "feature")) (list
              (el "span" (list (attr :class "num")) (list
                (txt "02")
              ))
              (el "h3" nil (list
                (txt "Stripe when you are ready")
              ))
              (el "p" nil (list
                (txt "Pick a plan and add payment details to start the 7-day trial. Cancel anytime.")
              ))
            ))
            (el "article" (list (attr :class "feature")) (list
              (el "span" (list (attr :class "num")) (list
                (txt "03")
              ))
              (el "h3" nil (list
                (txt "Leave with your data")
              ))
              (el "p" nil (list
                (txt "Export the desktop and move to self-hosted at any time. Open source means the exit is real.")
              ))
            ))
          ))
        ))
      ))
      ))))
