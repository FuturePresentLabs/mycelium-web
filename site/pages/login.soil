; SPDX-License-Identifier: MIT OR Apache-2.0
; Ported from public/login.html — keep the shared shell in site/site.soil.

(defun main ()
  (println
    (page
      "Sign in — Mycelium"
      "Sign in to a hosted Mycelium workspace with a passkey. Hosted access is opening in phases."
      "https://mycelium.fpl.dev/login"
      (list
      (el "section" (list (attr :class "auth-shell")) (list
        (el "div" (list (attr :class "auth-side")) (list
          (el "div" nil (list
            (el "p" (list (attr :class "eyebrow light")) (list
              (txt "Hosted Mycelium")
            ))
            (el "h2" nil (list
              (txt "Welcome back to the operating picture.")
            ))
            (el "p" nil (list
              (txt "FPL Auth handles passkeys, recovery, and account security. Your desktop stays yours.")
            ))
          ))
          (el "p" (list (attr :class "mono") (attr :style "font-size:10px;color:rgba(255,255,255,.42)")) (list
            (txt "MYCELIUM.FPL.DEV / SIGN IN")
          ))
        ))
        (el "div" (list (attr :class "auth-main")) (list
          (el "div" (list (attr :class "auth-card")) (list
            (el "p" (list (attr :class "eyebrow")) (list
              (txt "Sign in")
            ))
            (el "h1" nil (list
              (txt "Open your desktop.")
            ))
            (el "p" (list (attr :class "lede")) (list
              (txt "Hosted desktops are opening in phases. If your desktop is ready, use the sign-in link we emailed you.")
            ))
            (el "div" (list (attr :class "auth-actions")) (list
              (el "a" (list (attr :class "btn primary") (attr :href "https://m.fpl.dev/v1/auth/login")) (list
                (txt "Continue with FPL Auth ")
                (el "span" (list (attr :class "arrow") (attr :aria-hidden "true")) (list
                  (txt "→")
                ))
              ))
              (el "a" (list (attr :class "btn") (attr :href "/download")) (list
                (txt "Self-host instead")
              ))
            ))
            (el "details" (list (attr :style "margin-top:22px")) (list
              (el "summary" (list (attr :class "auth-small") (attr :style "cursor:pointer")) (list
                (txt "Using a customer email? Request a one-time link")
              ))
              (el "form" (list (attr :id "magic-login") (attr :novalidate #t) (attr :style "margin-top:14px")) (list
                (el "div" (list (attr :class "field")) (list
                  (el "label" (list (attr :for "login-email")) (list
                    (txt "Work email")
                  ))
                  (el "input" (list (attr :id "login-email") (attr :name "email") (attr :type "email") (attr :autocomplete "email") (attr :placeholder "you@company.com") (attr :required #t)) nil)
                ))
                (el "div" (list (attr :class "auth-actions")) (list
                  (el "button" (list (attr :class "btn") (attr :type "submit")) (list
                    (txt "Email me a sign-in link ")
                    (el "span" (list (attr :class "arrow") (attr :aria-hidden "true")) (list
                      (txt "→")
                    ))
                  ))
                ))
                (el "p" (list (attr :id "login-status") (attr :class "auth-small") (attr :role "status") (attr :aria-live "polite")) nil)
              ))
            ))
            (el "div" (list (attr :class "passkey-note") (attr :style "margin-top:18px")) (list
              (el "span" (list (attr :aria-hidden "true")) (list
                (txt "✦")
              ))
              (el "div" nil (list
                (el "b" nil (list
                  (txt "Passkey-first.")
                ))
                (txt " FPL Auth handles passkeys and recovery, then returns you to m.fpl.dev. The SSO launcher is bypassed for normal sign-in.")
              ))
            ))
            (el "p" (list (attr :class "auth-small")) (list
              (txt "Need a new workspace? ")
              (el "a" (list (attr :href "/signup")) (list
                (txt "Start here")
              ))
              (txt ". Trouble signing in? ")
              (el "a" (list (attr :href "mailto:hello@fpl.dev")) (list
                (txt "hello@fpl.dev")
              ))
              (txt ".")
            ))
          ))
        ))
      ))
      ))))
